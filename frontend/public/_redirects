{
  "customHeaders": [
    {
      "pattern": "**/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/<*>",
      "target": "/index.html",
      "status": "200",
      "condition": null
    }
  ]
}
